rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // System initialization metadata
    match /system/{metaId} {
      allow read, write, delete: if true;
    }

    // Users / Staff collection: All store terminals sync staff profiles across devices
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Products catalog: All store terminals sync inventory items across devices in real-time
    match /products/{productId} {
      allow read, write, delete: if true;
    }

    // Sales ledger & receipts: Real-time sales transactions synced across all devices
    match /sales/{saleId} {
      allow read, write, delete: if true;
    }

    // Customers and credit accounts: Synced across devices
    match /customers/{customerId} {
      allow read, write, delete: if true;
    }

    // Expenses: Synced across devices
    match /expenses/{expenseId} {
      allow read, write, delete: if true;
    }

    // Credit transactions & stamps: Synced across devices
    match /credit_transactions/{txId} {
      allow read, write, delete: if true;
    }

    // Audit logs: Activity logged across all devices
    match /audit_logs/{logId} {
      allow read, write, delete: if true;
    }

    // Settings: Store configuration synced across devices
    match /settings/{settingId} {
      allow read, write, delete: if true;
    }
  }
}

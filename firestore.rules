rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'approved'
      );
    }

    // System initialization metadata
    match /system/{metaId} {
      allow read, write, delete: if true;
    }

    // Users collection: All store terminals sync staff profiles, create, update, and manage accounts across devices
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Products catalog: All store terminals sync inventory items across devices in real-time
    match /products/{productId} {
      allow read, write, delete: if true;
    }

    // Sales ledger & receipts
    match /sales/{saleId} {
      allow read, write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }

    // Customers and loyalty
    match /customers/{customerId} {
      allow read, write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }

    // Credit transactions
    match /credit_transactions/{txId} {
      allow read, write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() || !exists(/databases/$(database)/documents/system/setup);
    }
  }
}
